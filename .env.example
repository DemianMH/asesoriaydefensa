# ==========================================================
# Variables de entorno — Asesoría y Defensa Laboral
# Configura estas variables en Netlify:
# Site settings > Environment variables
# ==========================================================

# URL pública del sitio (sin slash final). Úsala para SEO / sitemap / metadata.
NEXT_PUBLIC_SITE_URL=https://asesoriaydefensalaboral.com.mx

# --- Panel administrador ---
# Contraseña para entrar a /admin (elige una contraseña fuerte).
ADMIN_PASSWORD=cambia-esta-contrasena
# Cadena secreta aleatoria usada para firmar la cookie de sesión del admin.
# Genera una con: openssl rand -hex 32
ADMIN_SECRET=cambia-esta-cadena-secreta-larga-y-aleatoria

# --- Correo saliente (formulario de contacto) ---
# Datos SMTP del correo del dominio (plan básico de DirectAdmin en Neubox).
# Los obtienes en DirectAdmin > Cuentas de correo > (tu correo) > Configurar
# cliente de correo: ahí aparece el host, puerto y si usa SSL/TLS.
SMTP_HOST=mail.asesoriaydefensalaboral.com.mx
SMTP_PORT=465
SMTP_USER=contacto@asesoriaydefensalaboral.com.mx
SMTP_PASS=tu-contrasena-de-correo
# Remitente que verán los destinatarios (normalmente igual a SMTP_USER).
SMTP_FROM=contacto@asesoriaydefensalaboral.com.mx
# A quién le llegan los mensajes del formulario de contacto.
CONTACT_TO_EMAIL=contacto@asesoriaydefensalaboral.com.mx

# --- WhatsApp ---
# Se configura desde el panel admin (Contenido general > Información de contacto),
# pero puedes dejar aquí el número de referencia: 33 1455 7020 (523314557020).

# --- ManyChat ---
# El widget del chatbot (widget.manychat.com) ya está incrustado directamente en
# src/app/layout.tsx y NO necesita esta clave para mostrarse. Esta API key es
# privada (nunca debe ir en el navegador) y solo se documenta aquí por si en el
# futuro se agrega una integración desde el servidor (por ejemplo, mandar los
# mensajes del formulario de contacto a ManyChat). Hoy no se usa en el código.
MANYCHAT_API_KEY=tu-api-key-de-manychat
